# ==============================================================================
# FindGrid Platform Environment Variables (.env.example)
# ==============================================================================

# --- Backend Configuration ---
PROJECT_NAME="FindGrid — AI Missing Person Search & Coordination Platform"
DATABASE_URL="sqlite:///./findgrid.db"
# For Supabase PostgreSQL production:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional Supabase API keys (if using Supabase Auth / Storage)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Security
JWT_SECRET="findgrid-super-secret-jwt-key-2026-production-grade"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
NONCE_EXPIRE_MINUTES=10

# Blockchain / Web3
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
# Or Sepolia RPC:
# BLOCKCHAIN_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Deployed FindGridEvidenceRegistry contract address
EVIDENCE_REGISTRY_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# --- Frontend Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
VITE_CHAIN_ID=31337
